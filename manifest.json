{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "en",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "src/bg/worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/bamti-16.png",
      "24": "icons/bamti-24.png",
      "32": "icons/bamti-32.png",
      "48": "icons/bamti-48.png",
      "128": "icons/bamti-128.png"
    },
    "default_title": "__MSG_actionTitle__"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "commands": {
    "scan-page": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "MacCtrl+Shift+B"
      },
      "description": "__MSG_scanCommand__"
    }
  },
  "icons": {
    "16": "icons/bamti-16.png",
    "32": "icons/bamti-32.png",
    "48": "icons/bamti-48.png",
    "128": "icons/bamti-128.png"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ]
}
